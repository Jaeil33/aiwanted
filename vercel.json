{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/interpret.ts": {
      "maxDuration": 20
    },
    "api/verdict.ts": {
      "maxDuration": 60
    },
    "api/games.ts": {
      "maxDuration": 10
    },
    "api/game.ts": {
      "maxDuration": 20
    }
  }
}
